# ============================================================
# متغيرات البيئة — الملف ده قائمة بالأسماء، مفيش فيه ولا قيمة حقيقية.
#
# انسخه إلى `.env.local` للتطوير المحلي، وحطّ نفس الأسماء في
# Vercel → Settings → Environment Variables للإنتاج.
#
# ⚠️ `.env.local` متجاهَل في .gitignore — ما يترفعش على GitHub أبدًا.
#
# القاعدة: أي متغير بادئته `NEXT_PUBLIC_` **بيوصل للمتصفح**، يعني أي زائر
# يقدر يقراه من كود الصفحة. أي حاجة سرّية تبقى من غير البادئة دي.
# ============================================================

# ── Supabase ────────────────────────────────────────────────

# عنوان المشروع والمفتاح العام. الاتنين عامّان بطبيعتهما — الحماية
# الحقيقية في قواعد RLS على القاعدة، مش في إخفاء المفتاح.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY — لإنشاء الحسابات ودعوة المستخدمين من لوحة
# الإدارة، وللمهمة اليومية.
# ⚠️ المفتاح ده بيتخطى كل قواعد الحماية في قاعدة البيانات.
# - خادم فقط: من غير بادئة NEXT_PUBLIC_ عشان ما يوصلش للمتصفح إطلاقًا
# - ما يتحطش في Git إطلاقًا — يتحط في Vercel وفي .env.local المحلي بس
# - قيمته من: Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── الموقع ──────────────────────────────────────────────────

# NEXT_PUBLIC_SITE_URL — الدومين الحقيقي للموقع، من غير شرطة في الآخر.
# ده اللي بيتكتب في الروابط القانونية (canonical) وخريطة الموقع وصور المشاركة.
# لازم يتظبط في Vercel؛ من غيره الموقع بيستخدم قيمة احتياطية مكتوبة في الكود.
NEXT_PUBLIC_SITE_URL=https://alrehlat.vercel.app

# ── Cloudinary ──────────────────────────────────────────────

# رفع صور العملاء من المتصفح مباشرةً (unsigned).
# القيمتين دول عامّين بحكم التصميم — الـpreset الـunsigned مفيهوش سر.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dwg0hr34g"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="alreha"

# ── المهمة اليومية ──────────────────────────────────────────

# CRON_SECRET — كلمة سر المهمة اليومية لإشعارات مهلة التسليم
# (`/api/cron/service-due`، جدولتها في vercel.json).
#
# ⚠️ **إجباري.** من غيره المسار بيرجّع 503 والمهمة بتتوقف — وده مقصود:
#    المهمة بتشتغل بمفتاح الخدمة، ومسار مفتوح بيخلّي أي حد يعرف الرابط
#    يبعت إشعارات للناس. مهمة متوقفة أوضح من مهمة مفتوحة.
#
# القيمة: أي نص عشوائي طويل. Vercel بتبعته في ترويسة Authorization
# مع كل تشغيل للمهام المجدولة.
CRON_SECRET=any-long-random-string

# ============================================================
# متغيرات كانت هنا واتشالت — ما ترجّعهاش:
#
#   GEMINI_API_KEY · APP_URL
#     بقايا من أيام AI Studio. مفيش سطر واحد في الكود بيقراهم.
#
#   NEXT_PUBLIC_SHOW_DEV_TOOLBAR
#     كان بيظهّر شريط تبديل الأدوار اللي بيكتب كوكي `mockRole` —
#     وده كان بيدّي أي زائر **صلاحيات مدير نظام كاملة** بلا تسجيل دخول.
#     الشريط والكوكي والمستخدم الوهمي كلهم اتشالوا من الكود.
#     المتغير فضل مكتوب هنا بعدهم، وجنبه تحذير «لازم يتقفل قبل الإطلاق» —
#     تحذير عن حاجة مش موجودة أصلًا. ملف بيوصف حاجة مش في الكود
#     بيخلّي القارئ يدوّر على قفل مقفول، أو أسوأ: يفكّر إنه مفتوح.
# ============================================================
